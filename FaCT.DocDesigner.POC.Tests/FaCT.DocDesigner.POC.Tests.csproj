<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="PuppeteerSharp" Version="25.12.0" />
    <!-- PuppeteerSharp 25 needs System.Text.Json 10 (same pin as FaCT.DocDesigner.POC). -->
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaCT.DocDesigner.POC\FaCT.DocDesigner.POC.csproj" />
  </ItemGroup>

  <!-- Export parity tests fill exported Word templates with DocGen's own filler (sibling repo), when it is checked out. -->
  <PropertyGroup>
    <DocGenFiller>$(MSBuildThisFileDirectory)..\..\fact-docgen\src\MoE.Commercial.Documents.Generation.Service\CustomDocuments\Docx\DocxTemplateFiller.cs</DocGenFiller>
    <DefineConstants Condition="Exists('$(DocGenFiller)')">$(DefineConstants);DOCGEN_FILLER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DocGenFiller)')">
    <Compile Include="$(DocGenFiller)" Link="DocGen\DocxTemplateFiller.cs" />
  </ItemGroup>

</Project>
