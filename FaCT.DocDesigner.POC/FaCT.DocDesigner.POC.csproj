<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Fluid.Core" Version="2.40.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="PuppeteerSharp" Version="25.12.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- GrapesJS is served from node_modules; install it on first build. -->
  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('node_modules/grapesjs/dist/grapes.min.js')">
    <Exec Command="npm install --no-audit --no-fund" />
  </Target>

</Project>
